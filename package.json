{
  "name": "mcp-server-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starting point for an MCP server that fronts an existing HTTP API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
