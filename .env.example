# Copy to .env and fill in. .env is gitignored and must stay that way.

# ── This server ─────────────────────────────────────────────────────
PORT=9000
MCP_SERVER_NAME=mcp-server-template
MCP_SERVER_VERSION=0.1.0

# Shared secret the calling platform sends as `Authorization: Bearer <secret>`.
# Leave EMPTY in local development to disable the check. Never leave it empty in
# production: anything that can reach the port could otherwise drive the tools.
MCP_SHARED_SECRET=

# ── The API these tools front ───────────────────────────────────────
# Required — the server refuses to start without it. No trailing slash.
UPSTREAM_BASE_URL=https://api.example.com

# Sent as `Authorization: Bearer …` on every upstream call. Leave empty if the
# API authenticates some other way and adjust src/lib/api-client.ts to match.
UPSTREAM_API_KEY=

# Give up on an upstream request after this long. Without a bound, one hung
# request hangs the tool call and the caller has no way to recover.
UPSTREAM_TIMEOUT_MS=30000

# ── Conversation state ──────────────────────────────────────────────
# How long per-conversation state is kept after its last use. In memory only:
# a restart clears it, so nothing that must survive one belongs there.
CONVERSATION_TTL_MS=43200000

# ── Logging ─────────────────────────────────────────────────────────
# [TOOL START/END] and [UPSTREAM START/END] lines on stdout. Set to 0 to silence.
LOG_TIMING=1

# ── The business itself ─────────────────────────────────────────────
# Read by get_service_info and by the minimum-order rule. Kept here rather than
# in a handler so changing them does not need a deploy.
SERVICE_NAME=Example Shop
SERVICE_ADDRESS=1 Example Street, Example City
SERVICE_HOURS=Mon–Sat, 9am–7pm
# 0 disables the minimum-order check.
SERVICE_MINIMUM_ORDER=2000
