# Copy to .env and fill in. .env is gitignored and must stay that way.

# ── This server ─────────────────────────────────────────────────────
PORT=9000
MCP_SERVER_NAME=mcp-server-template
MCP_SERVER_VERSION=0.1.0

# Shared secret the calling platform sends as `Authorization: Bearer <secret>`.
# Leave EMPTY in local development to disable the check. Never leave it empty in
# production: anything that can reach the port could otherwise drive the tools.
MCP_SHARED_SECRET=

# ── Transport ───────────────────────────────────────────────────────
# Give up on any upstream request after this long. Applies to every service:
# a hung request holds the tool call open whichever host it went to.
REQUEST_TIMEOUT_MS=30000

# ── Conversation state ──────────────────────────────────────────────
# How long per-conversation state is kept after its last use. In memory only:
# a restart clears it, so nothing that must survive one belongs there.
CONVERSATION_TTL_MS=43200000

# ── Logging ─────────────────────────────────────────────────────────
# [TOOL START/END] and [UPSTREAM START/END] lines on stdout. Set to 0 to silence.
LOG_TIMING=1

# ── GoHighLevel (the appointment tools) ─────────────────────────────
# A second upstream, with its own host and token. Leave the token empty and the
# appointment tools refuse politely rather than calling GHL half-configured.
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# Slots are returned in this zone unless the caller names another, and a mobile
# number without a country code gets this one.
GHL_TIMEZONE=Asia/Kolkata
GHL_DEFAULT_COUNTRY_CODE=91

# The calendars API refuses a window wider than this.
GHL_MAX_RANGE_DAYS=31
